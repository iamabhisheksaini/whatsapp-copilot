# Copy to .env and fill in. Never commit .env.

# --- LLM -------------------------------------------------------------------
# Chat completions. Defaults to OpenRouter; use https://api.openai.com/v1 for
# OpenAI directly (and then set CHAT_MODEL=gpt-4o-mini).
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=openai/gpt-4o-mini

# Embeddings. Configured separately because not every OpenAI-compatible gateway
# exposes /embeddings. Leave EMBEDDINGS_API_KEY blank to reuse OPENAI_API_KEY.
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# --- Vector store ----------------------------------------------------------
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=knowledge
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVE_K=4

# --- Agent behaviour -------------------------------------------------------
# Answers below this confidence are flagged so n8n can ask the user to rephrase.
CONFIDENCE_FLOOR=0.6
# Set false to skip the self-reflection pass (one fewer LLM call per answer).
SELF_REFLECT=true
LOG_LEVEL=INFO

# --- n8n -------------------------------------------------------------------
GENERIC_TIMEZONE=Asia/Kolkata
# Public https URL Meta posts webhooks to (e.g. your ngrok tunnel).
WEBHOOK_URL=http://localhost:5678/

# --- WhatsApp (Meta Cloud API) ---------------------------------------------
# Credentials themselves live in n8n's credential store, not here.
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Google (IDs only; OAuth credentials live in n8n) ----------------------
DRIVE_KNOWLEDGEBASE_FOLDER_ID=
DRIVE_PROPOSALS_FOLDER_ID=
DRIVE_PROPOSAL_TEMPLATE_ID=
SHEET_CONVERSATIONS_ID=
SHEET_CRM_ID=
# Your Google account email. The Calendar node validates this against an
# email regex, so the literal "primary" is rejected.
CALENDAR_ID=you@gmail.com
