{
  "name": "Nightly Reindex",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "id": "634f4dc1-09ae-5288-b2d0-3995f460aac8",
      "name": "Nightly 02:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "query",
        "queryString": "={{ \"'\" + $env.DRIVE_KNOWLEDGEBASE_FOLDER_ID + \"' in parents and trashed = false\" }}",
        "returnAll": true,
        "options": {}
      },
      "id": "51629f8d-241d-5acf-9bd2-3c6b93c63063",
      "name": "List KnowledgeBase",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        220,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "options": {
          "binaryPropertyName": "data"
        }
      },
      "id": "54b92bcf-09be-5983-940b-53359abb7d06",
      "name": "Download File",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        440,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "data",
        "options": {}
      },
      "id": "75253839-a4ab-56af-a885-8a1bbd5b351f",
      "name": "Extract Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        660,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_A_URL }}/agentA/ingest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filename: $('Download File').item.json.name || 'unknown', driveFileId: $('Download File').item.json.id, text: $json.text || '', metadata: { source: 'nightly_reindex' } }) }}",
        "options": {
          "timeout": 300000,
          "batching": {
            "batch": {
              "batchSize": 2,
              "batchInterval": 1000
            }
          }
        }
      },
      "id": "a3f8807e-24d6-5981-a0a4-a6437032a9ff",
      "name": "Agent A — Reingest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        200
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.SHEET_CRM_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "CRM",
          "mode": "name"
        },
        "options": {}
      },
      "id": "56224567-326c-5797-8a5b-d65050e4a8f7",
      "name": "Read CRM",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        460
      ],
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "parameters": {
        "jsCode": "// A lead with no next step booked and no touch in a week needs a nudge.\nconst WEEK_MS = 7 * 24 * 60 * 60 * 1000;\nconst now = Date.now();\nreturn $input.all()\n  .filter(i => {\n    const row = i.json;\n    if (['Won', 'Lost'].includes(row.Stage)) return false;\n    if (row.NextStepDate) return false;\n    const ts = Date.parse(row.Timestamp);\n    return Number.isFinite(ts) && (now - ts) > WEEK_MS;\n  })\n  .map(i => ({ json: i.json }));"
      },
      "id": "183a390d-dfce-5f0e-9e74-d73868d528dc",
      "name": "Stale Over 7 Days",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        460
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{ $env.WHATSAPP_PHONE_ID }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "facebookGraphApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.Owner, type: 'text', text: { body: 'No movement on *' + $json.Company + '* for over a week. Want to schedule a follow-up?' } }) }}",
        "options": {}
      },
      "id": "24717647-4d0b-5160-acd4-ee0179cbd650",
      "name": "Nudge Owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        460
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Nightly 02:00": {
      "main": [
        [
          {
            "node": "List KnowledgeBase",
            "type": "main",
            "index": 0
          },
          {
            "node": "Read CRM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List KnowledgeBase": {
      "main": [
        [
          {
            "node": "Download File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download File": {
      "main": [
        [
          {
            "node": "Extract Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Text": {
      "main": [
        [
          {
            "node": "Agent A — Reingest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read CRM": {
      "main": [
        [
          {
            "node": "Stale Over 7 Days",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Stale Over 7 Days": {
      "main": [
        [
          {
            "node": "Nudge Owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "={{ $env.ERROR_WORKFLOW_ID }}"
  },
  "pinData": {}
}
